@startuml ICONIX-Kit-State-Machine

skinparam state {
  BackgroundColor<<gate>>    #FFD580
  BackgroundColor<<agent>>   #AED6F1
  BackgroundColor<<bug>>     #F1948A
  BackgroundColor<<change>>  #A9DFBF
  BorderColor                #2C3E50
  FontSize                   12
}
skinparam ArrowColor #2C3E50

' ── Entry ──────────────────────────────────────────────────────────────
[*] --> Idle

state "Idle" as Idle
Idle --> BranchCreate : raw input\n(BRD / transcript / feature request)

' ── Phase 0 : Branch creation (Git Agent) ──────────────────────────────
state "Branch creation\n(Git Agent — user confirms)" as BranchCreate <<agent>>
BranchCreate --> Requirements : feature/UC-XXX-<slug>\ncreated + confirmed

' ── Phase 1 : Requirements ─────────────────────────────────────────────
state "Product Owner" as Requirements <<agent>> {
  [*] --> DraftREQs
  DraftREQs        --> DraftDomainModel : REQ-XXX files written
  DraftDomainModel --> DraftUCs         : initial domain model drawn\n(real-world entities + is-a/has-a)
  DraftUCs         --> M1Checklist      : UC two-column flows written
  M1Checklist      --> [*]              : checklist passed
}

Requirements --> M1Gate : UCs + REQs ready

' ── Gate M1 ────────────────────────────────────────────────────────────
state "M1 Gate\n(Traceability)" as M1Gate <<gate>>
M1Gate --> Requirements : [REQ→UC links broken\nor M1 checklist fails]
M1Gate --> PrelimDesign  : [all REQ→UC links valid]

' ── Phase 2 : Preliminary Design (Analyst ∥ Architect) ─────────────────
state "Preliminary Design" as PrelimDesign {
  state "Analyst" as Analyst <<agent>>
  state "Architect" as Architect <<agent>>

  note "Analyst and Architect\nrun in parallel" as N1

  [*]       --> Analyst
  Analyst   --> Architect : RBs + domain model ready\n(Architect may start once\nfirst RBs exist)
  Architect --> [*]       : container mapping\n+ ADRs ready
}

PrelimDesign --> M2Gate : RBs + domain model\n+ container mapping done

' ── Gate M2 ────────────────────────────────────────────────────────────
state "M2 Gate / PDR\n(Traceability)" as M2Gate <<gate>>
state "Concurrent-touch\nresolution\n(Architect)" as ConcurrentResolve <<change>>

M2Gate --> PrelimDesign      : [RB rule violations\nor UC→RB links invalid]
M2Gate --> ConcurrentResolve : [HIGH concurrent-touch\nconflicts detected\n(write/write, controller\ncollision, DB write/write)]
M2Gate --> CDRPhase          : [M2 passed — all RBs valid\n+ no HIGH conflicts\n(or accepted)]
ConcurrentResolve --> M2Gate : ADRs + UC/RB updates\nlanded; re-run gate

' ── Phase 3 : Detailed Design + Testing (Developer ∥ Tester) ───────────
state "CDR Phase" as CDRPhase {
  state "Developer" as Developer <<agent>>
  state "Tester" as Tester <<agent>>

  note "Developer and Tester\nrun in parallel" as N2

  [*]       --> Developer
  Developer --> Tester    : SDs + class model ready\n(Tester starts once\nfirst SDs exist)
  Tester    --> [*]       : TCs + test plan ready
}

CDRPhase --> M3Gate : SDs + class model\n+ TCs + test plan done

' ── Gate M3 ────────────────────────────────────────────────────────────
state "M3 Gate / CDR\n(Traceability)" as M3Gate <<gate>>
M3Gate --> CDRPhase       : [SD→CLS→TC links broken\nor test plan missing]
M3Gate --> Implementation : [M3 passed]

' ── Phase 4 : Implementation loop (Phase 9 sub-states) ─────────────────
state "Implementation Loop" as Implementation <<agent>> {
  state "9.1 Implementation kickoff\n(Developer + Tester in parallel)" as Phase9_1
  state "9.2 Pre-merge drift check\n(Reviewer)" as Phase9_2
  state "9.3 Drift fix iteration\n(Developer + Tester)" as Phase9_3
  state "9.4 Implementation merge\n(STOP: PR confirm → draft PR → STOP: CI confirm → manual merge)" as Phase9_4
  state "Escalate to Architect / PO\n(iteration cap hit)" as Phase9_Escalate <<change>>

  [*]        --> Phase9_1
  Phase9_1   --> Phase9_2 : code + tests ready
  Phase9_2   --> Phase9_4 : APPROVE\nor APPROVE WITH NOTES
  Phase9_2   --> Phase9_3 : REQUEST CHANGES\nor BLOCK MERGE
  Phase9_3   --> Phase9_2 : drift fixes applied;\nre-review
  Phase9_3   --> Phase9_Escalate : iteration cap hit\n(phase9.max_iterations_per_uc)
  Phase9_Escalate --> PrelimDesign : architectural — back to Architect
  Phase9_Escalate --> Requirements : requirements-shaped — back to PO
  Phase9_4   --> [*]
}
Implementation --> Done : all UCs reach 9.4

' ── Done ───────────────────────────────────────────────────────────────
state "Done" as Done
Done --> [*]

' ── Bug Flow ────────────────────────────────────────────────────────────
' BugTriage is the only bug-flow-specific state. The Type 1 fix-and-verify
' loop is the SAME loop as Phase 9.3 → 9.2 — book Ch10 #9 treats it as one
' process, so we don't redraw the loop, we re-enter the Implementation
' Loop on a bugfix/T1-* branch instead of a feature/UC-* branch.
state "Bug Triage\n(Reviewer)" as BugTriage <<bug>>

note left of BugTriage
  Entry points:
  • /iconix-bug <ref>
    (direct — Reviewer triage)
  • /iconix-next
    (Orchestrator detects bug;
    see # Bug flow in
    iconix-orchestrator.md)
end note

Done --> BugTriage : bug reported on shipped feature
BugTriage --> Phase9_3 : Type 1 — code diverges from SD\n(re-enters Implementation Loop\nat 9.3 on bugfix/T1-* branch;\nReviewer uses Bug-fix verification mode at 9.2)
BugTriage --> REQChange : Type 2 — design is wrong\n→ full REQ change flow\n(eventually re-enters\nImplementation Loop)

' ── REQ Change Flow ──────────────────────────────────────────────────────
state "REQ Change\n(/iconix-impact → CI report)" as REQChange <<change>>

note right of REQChange
  Triggered at any time
  by the Orchestrator
  (see # REQ change flow in
  iconix-orchestrator.md)
end note

REQChange --> Requirements : scoped pipeline\n(only affected artifacts updated)

@enduml
