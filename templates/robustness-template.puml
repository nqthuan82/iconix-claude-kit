' ============================================================
' ICONIX connection rules:
'   Actor <-> Boundary           OK
'   Boundary <-> Controller      OK
'   Controller <-> Controller    OK
'   Controller <-> Entity        OK
' FORBIDDEN:
'   Actor -> Controller/Entity   (must go via Boundary)
'   Boundary -> Boundary         (must go via Controller)
'   Boundary -> Entity           (must go via Controller)
'   Entity -> Entity             (must go via Controller)
' ============================================================

skinparam actor {
  BackgroundColor #FFFFFF
}

!define BOUNDARY(x) entity "x" as x <<boundary>>
!define ENTITY(x) entity "x" as x <<entity>>
!define CONTROLLER(x) entity "x" as x <<controller>>

actor User as U

' Basic course elements
BOUNDARY(ScreenName)
CONTROLLER(DoSomething)
ENTITY(DomainClass)

U --> ScreenName
ScreenName --> DoSomething
DoSomething --> DomainClass

' Alternate course elements (shaded)
CONTROLLER(HandleError) #Pink
DoSomething --> HandleError
HandleError --> ScreenName

note bottom
  Traceability:
  - UC: UC-XXX
  - Downstream RB: (this file)
  - Sequence diagram: (filled by Developer)
end note

@enduml
